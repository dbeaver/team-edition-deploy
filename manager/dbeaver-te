#!/bin/bash

set -e

ARG="$1"
TEAM_EDITION_BASE_DIR="/opt/dbeaver-team-server/team-edition-deploy"
TEAM_EDITION_COMPOSE_DIR="$TEAM_EDITION_BASE_DIR/compose/cbte"
TEAM_EDITION_IMAGE="cloudbeaver-dc"
TEAM_EDITION_UPDATE_AVAILABLE=false

if [ ! -f "$TEAM_EDITION_COMPOSE_DIR/.env" ]; then
	echo "Warning: .env file not found at $TEAM_EDITION_COMPOSE_DIR/.env"
	if [ -f "$TEAM_EDITION_COMPOSE_DIR/.env.example" ]; then
		read -r -p "Do you want to create .env file from .env.example? [y/N] " response
		case "$response" in
			[yY][eE][sS]|[yY])
				cp "$TEAM_EDITION_COMPOSE_DIR/.env.example" "$TEAM_EDITION_COMPOSE_DIR/.env"
				echo ".env file created successfully!"
				echo "Please review and configure .env file: $TEAM_EDITION_COMPOSE_DIR/.env"
				;;
			*)
				echo "Cannot proceed without .env file. Exiting."
				exit 1
				;;
		esac
	else
		echo "Error: .env.example not found at $TEAM_EDITION_COMPOSE_DIR/.env.example"
		echo "Cannot create .env file. Exiting."
		exit 1
	fi
fi

while read -r line
do
	[[ $line =~ ^#.* ]] && continue
	[[ -z $line ]] && continue
	export "$line"
done < "$TEAM_EDITION_COMPOSE_DIR/.env"

TEAM_EDITION_TAG="$CLOUDBEAVER_VERSION_TAG"
VM_IMAGES_FILE="$TEAM_EDITION_COMPOSE_DIR/compose.vm-images.yml"
if [ -n "$TEAM_EDITION_VM_RELEASE" ]; then
	TEAM_EDITION_TAG="$TEAM_EDITION_VM_RELEASE"
fi

if [ "$DBEAVER_TEAM_EDITION_AMI" ] && [ -z "$COMPOSE_FILE" ] && grep -q '127\.0\.0\.1' "$TEAM_EDITION_COMPOSE_DIR/.env"; then
	echo "COMPOSE_FILE=docker-compose-nethost.yml" >> "$TEAM_EDITION_COMPOSE_DIR/.env"
	export COMPOSE_FILE="docker-compose-nethost.yml"
fi

COMPOSE_FILE="${COMPOSE_FILE:-docker-compose.yml}"
if [ -n "$TEAM_EDITION_VM_RELEASE" ]; then
	COMPOSE_FILE="${COMPOSE_FILE%%:*}"
fi

if [ "${PRODUCT_MODIFIER_ID}" = "aws" ] || grep -q "cloudbeaver-dc-aws:" "$TEAM_EDITION_COMPOSE_DIR/$COMPOSE_FILE"; then
	PRODUCT_MODIFIER_ID="aws"
	TEAM_EDITION_IMAGE="cloudbeaver-dc-aws"
fi

case $(uname -m) in

  "x86_64")
    OS_ARCH="amd64"
    ;;

  "aarch64")
    OS_ARCH="arm64"
    ;;

esac

printHelp() {
	cat << EOF

DBeaver Corp.
DBeaver Team Edition Server $TEAM_EDITION_TAG

Usage: dbeaver-te [command]

    commands:
      - help       print this help
      - stop       stop DBeaver Team Edition Server
      - start      start DBeaver Team Edition Server
      - configure  open .env file for configuration
      - update <version>
                   update DBeaver Team Edition Server to <version>
                   <version> can't be lower than current version $TEAM_EDITION_TAG
                   If version is not specified, check the configured release line on
                   a rolling VM or use the \`latest\` tag on other installations.
      - update list
                   print avialable versions for update
      - createBackup create backup all cluster in tar archive
      - restoreBackup <archive.tar.gz> 
                   restor your backup in current cluster

DBeaver TE server home directory: 
    $TEAM_EDITION_COMPOSE_DIR/
EOF
}

printSupportMessage() {
    cat << EOF

===============================================================================
If you have any questions or encounter any issues,  
please feel free to contact our support team:  
https://dbeaver.com/tickets/
===============================================================================

EOF
}

checkInternetConnection() {
	curl -s -o /dev/null  https://hub.docker.com
	if [ ! $? -eq 0 ]
	then
	    echo "Can't update DBeaver Team Edition Server. No internet connection."
	    exit 127
	fi
}

getAvailableVersions() {
	curl -s https://hub.docker.com/v2/repositories/dbeaver/"$TEAM_EDITION_IMAGE"/tags | jq -r '.results[].name | select(test("^[0-9]+\\.[0-9]+\\.[0-9]+$"))'
}

baseCompose() {
	docker compose --env-file "$TEAM_EDITION_COMPOSE_DIR/.env" \
		--project-directory "$TEAM_EDITION_COMPOSE_DIR/" \
		-f "$TEAM_EDITION_COMPOSE_DIR/$COMPOSE_FILE" "$@"
}

runningCompose() {
	if [ -n "$TEAM_EDITION_VM_RELEASE" ]; then
		docker compose --env-file "$TEAM_EDITION_COMPOSE_DIR/.env" \
			--project-directory "$TEAM_EDITION_COMPOSE_DIR/" \
			-f "$TEAM_EDITION_COMPOSE_DIR/$COMPOSE_FILE" -f "$VM_IMAGES_FILE" "$@"
	else
		baseCompose "$@"
	fi
}

isVmRelease() {
	[[ "$1" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.0(\.[1-9][0-9]*)?$ ]] &&
		(( BASH_REMATCH[1] > 26 || (BASH_REMATCH[1] == 26 && BASH_REMATCH[2] >= 3) ))
}

# With a channel selected, verify that every release image matches the exact tag
# before pinning the local images. Independent images are pinned too, for rollback.
pinVmImages() (
	set -e
	local exact="$1" channel="$2" output="$3" config entries service image id alias_id pin
	isVmRelease "$exact" || exit 1
	config=$(CLOUDBEAVER_VERSION_TAG="$exact" baseCompose config --format json)
	entries=$(jq -er '.services | to_entries[] | [.key, .value.image] | @tsv' <<< "$config")
	CLOUDBEAVER_VERSION_TAG="$exact" baseCompose pull -q
	if [ "$channel" != "$exact" ]; then
		CLOUDBEAVER_VERSION_TAG="$channel" baseCompose pull -q
	fi
	printf 'services:\n' > "$output"
	while IFS=$'\t' read -r service image; do
		id=$(docker image inspect --format '{{.Id}}' "$image")
		if [[ "$image" == *":$exact" && "$channel" != "$exact" ]]; then
			alias_id=$(docker image inspect --format '{{.Id}}' "${image%:*}:$channel")
			if [ "$id" != "$alias_id" ]; then
				echo "Image $image does not match ${image%:*}:$channel. Wait for the release to finish publishing." >&2
				exit 1
			fi
		fi
		pin="dbeaver-te-local/$service:${id#sha256:}"
		docker image tag "$id" "$pin"
		printf '  %s:\n    image: %s\n    pull_policy: never\n' "$service" "$pin" >> "$output"
	done <<< "$entries"
)

verifyVmImages() {
	local config entries service image containers container id
	config=$(runningCompose config --format json) || return 1
	entries=$(jq -er '.services | to_entries[] | [.key, .value.image] | @tsv' <<< "$config") || return 1
	while IFS=$'\t' read -r service image; do
		[[ "$image" == dbeaver-te-local/* ]] || return 1
		id=$(docker image inspect --format '{{.Id}}' "$image") || return 1
		containers=$(runningCompose ps -q "$service") || return 1
		for container in $containers; do
			[ "$(docker inspect --format '{{.Image}}' "$container")" = "$id" ] || return 1
		done
	done <<< "$entries"
}

vmRegistryTags() {
	local endpoint="https://hub.docker.com/v2/namespaces/dbeaver/repositories/$TEAM_EDITION_IMAGE/tags"
	local url="$endpoint?page_size=100" page
	[ -z "$1" ] || url="$url&name=$1."
	while [ -n "$url" ]; do
		page=$(curl -fsS --max-time 30 "$url") || return 1
		jq -r --arg digest "$2" '
			.results[] | select($digest == "" or .digest == $digest) | .name
			| select(test("^[0-9]+\\.[0-9]+\\.0(\\.[1-9][0-9]*)?$"))
			| select(split(".") | (.[0] | tonumber) > 26 or
				((.[0] | tonumber) == 26 and (.[1] | tonumber) >= 3))
		' <<< "$page" || return 1
		url=$(jq -r 'if has("next") then .next // "" else error("missing pagination") end' <<< "$page") || return 1
		[[ -z "$url" || "$url" == "$endpoint?"* ]] || return 1
	done
}

checkVmUpdateVersion() {
	local request="$1" channel digest versions response
	if [ "$request" = list ]; then
		versions=$(vmRegistryTags "" "") || exit 1
		printf '%s\n' "$versions" | sort -Vr
		exit 0
	fi
	case "$request" in
		""|latest)
			channel="$CLOUDBEAVER_VERSION_TAG"
			if isVmRelease "$channel"; then
				channel="$(cut -d. -f1,2 <<< "$channel")"
			fi
			[[ "$channel" =~ ^[0-9]+\.[0-9]+$ ]] || exit 1
			response=$(curl -fsS --max-time 30 "https://hub.docker.com/v2/namespaces/dbeaver/repositories/$TEAM_EDITION_IMAGE/tags/$channel")
			digest=$(jq -er '.digest | select(test("^sha256:[a-f0-9]{64}$"))' <<< "$response")
			versions=$(vmRegistryTags "$channel" "$digest")
			TEAM_EDITION_NEW_TAG=$(printf '%s\n' "$versions" | sort -Vr | head -n 1)
			if ! isVmRelease "$TEAM_EDITION_NEW_TAG"; then
				echo "No exact release matches image tag $channel." >&2
				exit 1
			fi
			VM_TARGET_CHANNEL="$channel"
			;;
		*)
			if ! isVmRelease "$request"; then
				echo "Use a full release version from 26.3 onward (for example, 26.3.0 or 26.3.0.1)." >&2
				exit 1
			fi
			TEAM_EDITION_NEW_TAG="$request"
			VM_TARGET_CHANNEL="$request"
			;;
	esac
	if [ "$TEAM_EDITION_NEW_TAG" = "$TEAM_EDITION_TAG" ] && [ "$VM_TARGET_CHANNEL" = "$CLOUDBEAVER_VERSION_TAG" ]; then
		echo "Same version already installed."
		return
	fi
	if [ -z "$request" ] || { [ "$TEAM_EDITION_NEW_TAG" != "$TEAM_EDITION_TAG" ] &&
		[ "$(printf '%s\n' "$TEAM_EDITION_NEW_TAG" "$TEAM_EDITION_TAG" | sort -V | head -n 1)" = "$TEAM_EDITION_NEW_TAG" ]; }; then
		read -r -p "Install $TEAM_EDITION_NEW_TAG? [y/N] " response
		case "$response" in
			[yY]|[yY][eE][sS]) ;;
			*) return ;;
		esac
	fi
	TEAM_EDITION_UPDATE_AVAILABLE=true
}

configureenvfile()
{
	nano "$TEAM_EDITION_COMPOSE_DIR/.env"
}

checkCloudBeaverUpdateVersion() {
	checkInternetConnection
	if [ -z "$1" ]
	then
		LATEST_DIGEST=$(curl -s https://hub.docker.com/v2/namespaces/dbeaver/repositories/"$TEAM_EDITION_IMAGE"/tags/latest | jq ".images[] | select(.architecture==\"${OS_ARCH}\" )| .digest ")
		DOCKER_REG=$(curl  -s  https://hub.docker.com/v2/repositories/dbeaver/"$TEAM_EDITION_IMAGE"/tags)
		LIST_TAGS=$(echo $DOCKER_REG | jq ".results[] | .name" | grep -E '[0-9]+\.[0-9]+\.[0-9]+' | sed 's/"//g')
		while read -r line; do tags+=("$line"); done <<<"$LIST_TAGS"
		for name in "${tags[@]}"; do
			if [ $(echo $DOCKER_REG | jq ".results[] | select(.name==\"$name\") | .images[] | select(.architecture==\"$OS_ARCH\") | .digest") == $LATEST_DIGEST ] 
			then 
			echo "Latest version is $name"
			LATEST_TAG=$name && break 
			fi
		done
		if [ $TEAM_EDITION_TAG == $LATEST_TAG ]
		then
			echo "Same version already installed. Passing"
			exit 0
		fi
		read -r -p "Do you want update to latest version ($LATEST_TAG) ? [y/N] " response
		case "$response" in
			[yY][eE][sS]|[yY])
				updateCloudbeaver "$LATEST_TAG"
				exit 0
				;;
			*)
				exit 0
				;;
		esac
	elif [ "$1" == "list" ]
	then
		getAvailableVersions
		exit 0
	elif [ "$1" == "latest" ]
	then
		LATEST_DIGEST=$(curl -s https://hub.docker.com/v2/namespaces/dbeaver/repositories/"$TEAM_EDITION_IMAGE"/tags/latest | jq ".images[] | select(.architecture==\"${OS_ARCH}\" )| .digest ")
		DOCKER_REG=$(curl  -s  https://hub.docker.com/v2/repositories/dbeaver/"$TEAM_EDITION_IMAGE"/tags)
		LIST_TAGS=$(echo $DOCKER_REG | jq ".results[] | .name" | grep -E '[0-9]+\.[0-9]+\.[0-9]+' | sed 's/"//g')
		while read -r line; do tags+=("$line"); done <<<"$LIST_TAGS"
		for name in "${tags[@]}"; do
			if [ $(echo $DOCKER_REG | jq ".results[] | select(.name==\"$name\") | .images[] | select(.architecture==\"$OS_ARCH\") | .digest") == $LATEST_DIGEST ] 
			then 
			echo "Latest version is $name"
			LATEST_TAG=$name && break 
			fi
		done
		TEAM_EDITION_NEW_TAG=$LATEST_TAG
		if [ $TEAM_EDITION_TAG == $TEAM_EDITION_NEW_TAG ]
		then
			echo "Same version already installed. Passing"
			exit 0
		fi
		TEAM_EDITION_UPDATE_AVAILABLE=true
	else
		if [[ ! "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
			echo "ERROR: Invalid version format <$1>. Expected format: x.x.x"
			exit 1
		fi
		TEAM_EDITION_NEW_TAG="$1"
		if [ $TEAM_EDITION_TAG == $TEAM_EDITION_NEW_TAG ]
		then
			echo "Same version already installed. Passing"
			exit 0
		fi

		echo -n "Check version $TEAM_EDITION_NEW_TAG available..."
		NEW_TAG_AVAILABLE_RESPONSE=$(curl -sI https://hub.docker.com/v2/repositories/dbeaver/"$TEAM_EDITION_IMAGE"/tags/"$TEAM_EDITION_NEW_TAG" 2>/dev/null | head -n 1|cut -d$' ' -f2)
		if [ "$NEW_TAG_AVAILABLE_RESPONSE" == "200" ]
		then
			echo "...ok"
			if [ "$(echo -e "$TEAM_EDITION_NEW_TAG\n$TEAM_EDITION_TAG" | sort -V | head -n1)" = "$TEAM_EDITION_NEW_TAG" ]
			then
				echo "DBeaver team does not recommend to downgrading the DBeaver Team Edition Server due to the enhancements and fixes."
				read -r -p "Are you sure to downgrade DBeaver Team Edition Server? [y/N] " response
				case "$response" in
				    [yY][eE][sS]|[yY])
				        TEAM_EDITION_UPDATE_AVAILABLE=true
				        ;;
				    *)
				        exit 0
				        ;;
				esac
			fi
		    TEAM_EDITION_UPDATE_AVAILABLE=true
		else
			echo -n "...ERROR"
		    echo -e "\nCan't update CloudBeaver: wrong version <$TEAM_EDITION_NEW_TAG>"
		    echo "Available version:"
		    getAvailableVersions
		    exit 127
		fi
	fi
	echo "Updating to version: $TEAM_EDITION_NEW_TAG"
}

TEAM_EDITION_STATUS=false
checkCloudBeaverStatus() {
	CB_STATUS_RESULT=$(curl -Iq -k https://localhost 2>/dev/null | head -n 1|cut -d$' ' -f2)
	if [ "$CB_STATUS_RESULT" == "200" ]
	then
		TEAM_EDITION_STATUS=true
	fi
}



startCloudbeaver() {
	checkCloudBeaverStatus
	if [ "$TEAM_EDITION_STATUS" == false ]
	then
		local pull_policy=always
		[ -z "$TEAM_EDITION_VM_RELEASE" ] || pull_policy=never
		runningCompose up -d --remove-orphans --pull "$pull_policy"

		TEAM_EDITION_STATUS_RETRY=300
		until [ $TEAM_EDITION_STATUS_RETRY -lt 0 ]
		do
			checkCloudBeaverStatus
			if [ "$TEAM_EDITION_STATUS" == true ]
			then
				echo -e "\nDBeaver Team Edition Server started."
				break
			fi
			echo -n "."
			let "TEAM_EDITION_STATUS_RETRY-=1"
			sleep 1
		done
	else
		echo "DBeaver Team Edition Server already up."
	fi

}

stopCloudbeaver() {
	checkCloudBeaverStatus
	docker compose -f "$TEAM_EDITION_COMPOSE_DIR/$COMPOSE_FILE" down 
	echo "DBeaver Team Edition Server stopped."
}

rollbackCloudBeaver() {
	BACKUP_DIR="$1"
	BACKUP_VERSION="$2"

	docker compose \
        -f "$TEAM_EDITION_COMPOSE_DIR/$COMPOSE_FILE" \
        --env-file "$TEAM_EDITION_COMPOSE_DIR/.env" \
        --project-directory "$TEAM_EDITION_COMPOSE_DIR/" \
        down \
        --remove-orphans

	cd "$TEAM_EDITION_BASE_DIR/"
	git checkout --force "${VM_PREVIOUS_COMMIT:-$BACKUP_VERSION}" || {
		echo "==============================================================================="
		echo "Error: Failed to checkout version $BACKUP_VERSION."
		echo "==============================================================================="
		printSupportMessage
		exit 1
	}

	rsync -av --exclude='cert' --exclude='nginx' "$BACKUP_DIR/" "$TEAM_EDITION_COMPOSE_DIR/"

    if [ -n "$TEAM_EDITION_VM_RELEASE" ]; then
        export CLOUDBEAVER_VERSION_TAG="$VM_PREVIOUS_CHANNEL"
    else
        sed -i \
            "s/CLOUDBEAVER_VERSION_TAG=$TEAM_EDITION_NEW_TAG/CLOUDBEAVER_VERSION_TAG=$BACKUP_VERSION/g" \
            "$TEAM_EDITION_COMPOSE_DIR/.env"
        export CLOUDBEAVER_VERSION_TAG="$BACKUP_VERSION"
    fi

	runningCompose up -d --remove-orphans

	TEAM_EDITION_STATUS=false
	TEAM_EDITION_STATUS_RETRY=300
	until [ $TEAM_EDITION_STATUS_RETRY -lt 0 ]; do
		checkCloudBeaverStatus
		if [ "$TEAM_EDITION_STATUS" == true ]; then
			echo -e "\nDBeaver Team Edition Server started successfully!"
			return 0
		fi
		echo -n "."
		TEAM_EDITION_STATUS_RETRY=$((TEAM_EDITION_STATUS_RETRY - 1))
		sleep 1
	done

	echo -e "ERROR: Failed to start after rollback."
	printSupportMessage
	exit 1
}

rollbackUpdate() {
	echo -e "\nERROR: $1. Rolling back to version $TEAM_EDITION_TAG..."
	rollbackCloudBeaver "$BACKUP_DIR" "$TEAM_EDITION_TAG"
	printSupportMessage
	exit 1
}

updateCloudbeaver() {
    if [ -n "$TEAM_EDITION_VM_RELEASE" ]; then
        checkVmUpdateVersion "$1"
    else
        docker ps -a | grep -q "$TEAM_EDITION_IMAGE" || exit 1
        checkCloudBeaverUpdateVersion "$1"
    fi
    
    if [ "$TEAM_EDITION_UPDATE_AVAILABLE" == true ]; then
        TIMESTAMP=$(date +%m-%d-%Y_%H-%M)
        BACKUP_DIR="${TEAM_EDITION_BASE_DIR}-${TEAM_EDITION_TAG}-${TIMESTAMP}"
        
        # Check if user has write permission for $TEAM_EDITION_BASE_DIR/
        if [ ! -w "$TEAM_EDITION_BASE_DIR/" ]; then
        	OWNER=$(ls -ld "$TEAM_EDITION_BASE_DIR/" | awk '{print $3}')
        	GROUP=$(ls -ld "$TEAM_EDITION_BASE_DIR/" | awk '{print $4}')
        
        	echo "Error: No write permission for $TEAM_EDITION_BASE_DIR/."
        	echo "Directory is owned by: $OWNER (group: $GROUP)."
        	
        	if [ "$(whoami)" != "$OWNER" ]; then
        		echo "You are currently logged in as $(whoami). Try switching to user: $OWNER"
        		echo "Use: sudo su $OWNER "
        	fi
        	printSupportMessage
        	exit 1
        fi
        
        # Check .git directory and fetch latest changes
        cd "$TEAM_EDITION_BASE_DIR/"
        if [ ! -d "$TEAM_EDITION_BASE_DIR/.git" ]; then
        	echo "==============================================================================="
        	echo "Error: .git directory not found. The repository may be missing or corrupted."
        	echo "Please clone the repository again."
        	echo "==============================================================================="
        	printSupportMessage
        	exit 1
        fi
        local target_commit
        if [ -n "$TEAM_EDITION_VM_RELEASE" ]; then
            local target_ref="refs/tags/$TEAM_EDITION_NEW_TAG"
            git fetch origin "$target_ref:$target_ref" || {
                echo "Deployment Git tag $TEAM_EDITION_NEW_TAG is required. The server was not stopped." >&2
                exit 1
            }
            target_commit=$(git rev-parse --verify "$target_ref^{commit}")
            VM_PREVIOUS_COMMIT=$(git rev-parse --verify HEAD)
            VM_PREVIOUS_CHANNEL="$CLOUDBEAVER_VERSION_TAG"
            verifyVmImages || {
                echo "Cannot verify the installed images for rollback. The server was not stopped." >&2
                exit 1
            }
            VM_STAGE_DIR=$(mktemp -d)
            trap 'rm -f -- "$VM_STAGE_DIR/$COMPOSE_FILE" "$VM_STAGE_DIR/.env" "$VM_STAGE_DIR/compose.vm-images.yml"; rmdir -- "$VM_STAGE_DIR"' EXIT
            git show "$target_commit:compose/cbte/$COMPOSE_FILE" > "$VM_STAGE_DIR/$COMPOSE_FILE"
            cp "$TEAM_EDITION_COMPOSE_DIR/.env" "$VM_STAGE_DIR/.env"
            if [ "${PRODUCT_MODIFIER_ID}" = aws ]; then
                sed -i 's/cloudbeaver-dc:\$/cloudbeaver-dc-aws:\$/g' "$VM_STAGE_DIR/$COMPOSE_FILE"
                grep -q 'cloudbeaver-dc-aws:' "$VM_STAGE_DIR/$COMPOSE_FILE"
            fi
            TEAM_EDITION_COMPOSE_DIR="$VM_STAGE_DIR" pinVmImages "$TEAM_EDITION_NEW_TAG" \
                "$VM_TARGET_CHANNEL" "$VM_STAGE_DIR/compose.vm-images.yml"
        else
            git fetch || {
                echo "==============================================================================="
                echo "Error: Failed to fetch latest changes from repository."
                echo "==============================================================================="
                printSupportMessage
                exit 1
            }
        fi
        
        # Backup current configuration
        mkdir -p "$BACKUP_DIR"
        rsync -av --exclude='cert' --exclude='nginx' "$TEAM_EDITION_COMPOSE_DIR/" "$BACKUP_DIR/"
        echo "Previous team-edition-deploy configuration copied to $BACKUP_DIR"
        
        git config user.name "DBeaver Support"
        git config user.email "support@dbeaver.com"

        USER_BACKUP_BRANCH="user-backup/${TEAM_EDITION_TAG}_${TIMESTAMP}"
        if [ -n "$(git status --porcelain)" ]; then
            git checkout -b "$USER_BACKUP_BRANCH"
            git add -A
            git commit -m "Auto-backup before update from $TEAM_EDITION_TAG to $TEAM_EDITION_NEW_TAG"
            echo "Your local changes have been saved in branch: $USER_BACKUP_BRANCH"
        fi

        # Stop team-edition-deploy
        docker compose \
            -f "$TEAM_EDITION_COMPOSE_DIR/$COMPOSE_FILE" \
            --env-file "$TEAM_EDITION_COMPOSE_DIR/.env" \
            --project-directory "$TEAM_EDITION_COMPOSE_DIR/" \
            down \
            --remove-orphans \
            || rollbackUpdate "Failed to stop the current version"

        # Checkout new version
        git checkout --force "${target_commit:-$TEAM_EDITION_NEW_TAG}" || {
        	echo "==============================================================================="
        	echo "Error: Failed to checkout version $TEAM_EDITION_NEW_TAG."
        	echo "==============================================================================="
        	rollbackCloudBeaver "$BACKUP_DIR" "$TEAM_EDITION_TAG"
        	printSupportMessage
        	exit 1
        }

        if [ "${PRODUCT_MODIFIER_ID}" = "aws" ]; then
            sed -i 's/cloudbeaver-dc\:\$/cloudbeaver-dc-aws\:\$/g' "$TEAM_EDITION_COMPOSE_DIR/$COMPOSE_FILE" \
                || rollbackUpdate "Failed to apply the AWS product modifier"
            if ! grep -q "cloudbeaver-dc-aws:" "$TEAM_EDITION_COMPOSE_DIR/$COMPOSE_FILE"; then
                echo "Error: Failed to apply the AWS product modifier to $COMPOSE_FILE."
                rollbackCloudBeaver "$BACKUP_DIR" "$TEAM_EDITION_TAG"
                printSupportMessage
                exit 1
            fi
        fi

        local image_tag="${VM_TARGET_CHANNEL:-$TEAM_EDITION_NEW_TAG}" pull_policy=always
        sed -i \
            "s/^CLOUDBEAVER_VERSION_TAG=.*/CLOUDBEAVER_VERSION_TAG=$image_tag/" \
            "$TEAM_EDITION_COMPOSE_DIR/.env" \
            || rollbackUpdate "Failed to update the version in .env"
        
        export CLOUDBEAVER_VERSION_TAG="$image_tag"

        # Update docker-compose volumes for AMI
        if [ "$DBEAVER_TEAM_EDITION_AMI" ]; then
            "$HOME/.local/bin/dbeaver-compose-config-editor.py" \
                -f "$TEAM_EDITION_COMPOSE_DIR/$COMPOSE_FILE" \
                -e "$TEAM_EDITION_COMPOSE_DIR/.env" || {
                    echo "==============================================================================="
                    echo "Error: Failed to patch docker-compose.yml using dbeaver-compose-config-editor.py."
                    echo "==============================================================================="
                    rollbackCloudBeaver "$BACKUP_DIR" "$TEAM_EDITION_TAG"
                    printSupportMessage
                    exit 1
                }
        fi
        
        # Start team-edition-deploy with new version and check status
        if [ -n "$TEAM_EDITION_VM_RELEASE" ]; then
            cp "$VM_STAGE_DIR/compose.vm-images.yml" "$VM_IMAGES_FILE" ||
                rollbackUpdate "Failed to save the new image pins"
            pull_policy=never
        fi
        runningCompose up -d --remove-orphans --pull "$pull_policy" ||
            rollbackUpdate "Failed to start the new version"
        
        TEAM_EDITION_STATUS_RETRY=300
        until [ $TEAM_EDITION_STATUS_RETRY -lt 0 ]; do
            checkCloudBeaverStatus
            if [ "$TEAM_EDITION_STATUS" == true ]; then
                if [ -n "$TEAM_EDITION_VM_RELEASE" ]; then
                    sed -i "s/^TEAM_EDITION_VM_RELEASE=.*/TEAM_EDITION_VM_RELEASE=$TEAM_EDITION_NEW_TAG/" \
                        "$TEAM_EDITION_COMPOSE_DIR/.env" ||
                        rollbackUpdate "Failed to record the installed release"
                fi
                echo -e "\nDBeaver Team Edition Server started successfully!"
                return 0
            fi
            echo -n "."
            TEAM_EDITION_STATUS_RETRY=$((TEAM_EDITION_STATUS_RETRY - 1))
            sleep 1
        done
        
        # Rollback to previous version if team-edition-deploy failed to start during 5 minutes
        echo -e "\nERROR: CloudBeaver failed to start. Rolling back to previous version..."
        rollbackCloudBeaver "$BACKUP_DIR" "$TEAM_EDITION_TAG"
        printSupportMessage
        exit 1

    fi
}


createBackup(){
    PROJECT_NAME=$COMPOSE_PROJECT_NAME
    BACKUP_PATH="./backup/$PROJECT_NAME"_$(date +%d%m%Y)
    mkdir -p $BACKUP_PATH
	DC_CONTAINER="$PROJECT_NAME-cloudbeaver-dc-1"
    services="cloudbeaver-dc cloudbeaver-tm cloudbeaver-rm"

    for SERVICE in $services; do
        VOLUME_PATH=$(docker inspect -f '{{ range .Mounts }}{{ if eq .Type "volume" }}{{ println .Destination }}{{ end }}{{ end }}' $PROJECT_NAME-"$SERVICE"-1 | grep '/workspace$')
		docker exec "$PROJECT_NAME-$SERVICE-1" sh -c "if [ -d '${VOLUME_PATH}' ] && [ \"\$(ls -A ${VOLUME_PATH})\" ]; then tar -czf - -C ${VOLUME_PATH} .;fi" > $BACKUP_PATH/"$SERVICE".tar.gz

    done

    if [ "$USE_EXTERNAL_DB" = false ]; then
        PG_SERVICE="postgres"
        DB_NAME="cloudbeaver"
        docker exec -e PGPASSWORD="$CLOUDBEAVER_DB_PASSWORD" $PROJECT_NAME-"$PG_SERVICE"-1 pg_dump -h localhost $DB_NAME --username $CLOUDBEAVER_DB_USER --format c > $BACKUP_PATH/"$PG_SERVICE".backup
    fi
    
    CERT_VOLUME_PATH="/opt/domain-controller/conf/certificates"
    
    docker exec "$DC_CONTAINER" tar -czf /tmp/cert.tar.gz -C "$CERT_VOLUME_PATH" .
    docker cp "$DC_CONTAINER:/tmp/cert.tar.gz" "$BACKUP_PATH/cert.tar.gz"

    tar -czf "$BACKUP_PATH".tar.gz $BACKUP_PATH
}

restoreBackup(){
    ARCHIVE_PATH=$1 
	PROJECT_NAME=$COMPOSE_PROJECT_NAME
    TEMP_DIR="./temp_restore"
    mkdir -p $TEMP_DIR

    tar -xzvf $ARCHIVE_PATH -C $TEMP_DIR

    ARCHIVE_NAME=$(basename $ARCHIVE_PATH)
    BACKUP_FOLDER_NAME="${ARCHIVE_NAME%.tar.gz}"
    BACKUP_DIR="$TEMP_DIR/backup/$BACKUP_FOLDER_NAME"
    ARCHIVE_DATE=$(echo $ARCHIVE_NAME | grep -o '[0-9]\{8\}')
	DC_CONTAINER="$PROJECT_NAME-cloudbeaver-dc-1"

    services="cloudbeaver-dc cloudbeaver-tm cloudbeaver-rm"
    for SERVICE in $services; do
        BACKUP_ARCHIVE_PATH="$BACKUP_DIR/${SERVICE}.tar.gz"
        VOLUME_PATH=$(docker inspect -f '{{ range .Mounts }}{{ if eq .Type "volume" }}{{ println .Destination }}{{ end }}{{ end }}' $PROJECT_NAME-"$SERVICE"-1 | grep '/workspace$')
        if [ -f "$BACKUP_ARCHIVE_PATH" ]; then
            echo "Restoring $SERVICE..."
			docker cp $BACKUP_ARCHIVE_PATH $PROJECT_NAME-"$SERVICE"-1:/tmp/${SERVICE}.tar.gz
			docker exec "$PROJECT_NAME-$SERVICE-1" tar -xzvf /tmp/${SERVICE}.tar.gz -C $VOLUME_PATH || { 
				echo "Error restoring $SERVICE workspace!"
				printSupportMessage
				exit 1
			}
			docker exec "$PROJECT_NAME-$SERVICE-1" rm /tmp/${SERVICE}.tar.gz
        else
            echo "Backup archive $BACKUP_ARCHIVE_PATH not found."
			printSupportMessage
			exit 1
        fi
    done

    DB_BACKUP="$BACKUP_DIR/postgres.backup"
    if [ -f "$DB_BACKUP" ]; then
        echo "Restoring PostgreSQL database..."
        docker exec -i -e PGPASSWORD="$CLOUDBEAVER_DB_PASSWORD" $PROJECT_NAME-"postgres"-1 pg_restore -h localhost --dbname cloudbeaver --username $CLOUDBEAVER_DB_USER --clean --if-exists < "$DB_BACKUP"
    else
        echo "PostgreSQL backup file not found."
		printSupportMessage
		exit 1
    fi

	CERT_BASE_PATH=$(
		docker inspect -f '{{ range .Mounts }}{{ if and (eq .Type "bind") (eq .Destination "/opt/domain-controller/conf/certificates") }}{{ .Source }}{{ end }}{{ end }}' \
		"$DC_CONTAINER"
    )
    
    CERT_ARCHIVE_PATH="$BACKUP_DIR/cert.tar.gz"
    if [ -n "$CERT_BASE_PATH" ] && [ -f "$CERT_ARCHIVE_PATH" ]; then
    	echo "Restoring all certificates to $CERT_BASE_PATH..."
        docker cp "$CERT_ARCHIVE_PATH" "$DC_CONTAINER:/tmp/cert.tar.gz"
    	docker exec "$DC_CONTAINER" sh -c "tar -xzvf /tmp/cert.tar.gz -C /opt/domain-controller/conf/certificates && rm -f /tmp/cert.tar.gz" || { 
    		echo "Error restoring certificates!"
    		printSupportMessage
    		exit 1
    	}
    else
    	echo "Certificates backup or path not found."
    	printSupportMessage
    	exit 1
    fi
	
    rm -rf $TEMP_DIR
    docker compose -f "$TEAM_EDITION_COMPOSE_DIR/$COMPOSE_FILE" down 
    runningCompose up -d
}

case $1 in

  "pin-vm-images")
    [ "$DBEAVER_TEAM_EDITION_AMI" = true ] && [ -z "$TEAM_EDITION_VM_RELEASE" ] || exit 1
    pinVmImages "$2" "$CLOUDBEAVER_VERSION_TAG" "$VM_IMAGES_FILE"
    ;;

  "help")
    printHelp
    ;;

  "start")
		docker ps -a -q \
			--filter "name=cbte-cloudbeaver-tm-1"  \
			--filter "status=exited" | \
			grep -q . \
			&& docker rm -f "cbte-cloudbeaver-tm-1"
    startCloudbeaver
    ;;

  "stop")
    stopCloudbeaver > /dev/null
    ;;

  "project")
    cdtoprojectdir
    ;;

  "configure")
    configureenvfile
    ;;

  "update")
    updateCloudbeaver "$2"
    ;;

  "createBackup")
    createBackup "$2" "$3"
    ;;

  "restoreBackup")
    restoreBackup "$2"
    ;;

  *)
	if [ -z "$1" ]
	  then
	  	printHelp
	  	echo ""
	    echo "---No argument supplied---"
	else
		printHelp
	fi
    ;;
esac
